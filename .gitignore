# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Harness & dev-server scratch (anything under **/build/ is already covered;
# this catches out-of-place run dirs)
run/
# ...but a Java package named run is source (behavior.run, logic.md §9)
!**/src/**/run/
logs/
.cache/

# OS
Thumbs.db
.DS_Store

# Secrets / local credentials — never commit
.env
.env.*
*.pem
*.jks
*.keystore
*.p12

# Future webui (M3) — ignored from day one so experiments don't leak in
webui/node_modules/

# Local reference material (not part of the product)
example-build/

# Claude Code local state (CLAUDE.md at root IS committed; this dir is not)
.claude/

# ZCode workspace
.zcode/

# Commandcode
.commandcode/

nexo-reference/

# Editor SPA build
webui/node_modules/
webui/dist/

# In-game QA run evidence (issue #38) — qa/catalog and qa/ledger are committed;
# run artifacts (screenshots, transcripts, dossiers) are machine-local
qa/results/

# Cloud worker (cloud/editor-worker) — npm + wrangler artifacts
cloud/editor-worker/node_modules/
cloud/editor-worker/dist/
cloud/editor-worker/.wrangler/
.wrangler/
