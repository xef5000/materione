    {
      "kind": "logicEdit",
      "path": "guis/forge.yml",
      "edits": [
        {
          "op": "addRule",
          "index": 0,
          "rule": {
            "on": "gui.click",
            "layer": "forge_button",
            "do": [
              {
                "if": {
                  "slot_has": {
                    "slot": 11,
                    "item": "sample:ruby_sword",
                    "amount": 1
                  }
                },
                "else": [
                  {
                    "message": "<red>Put a ruby sword in the first slot."
                  },
                  "stop"
                ]
              },
              {
                "if": {
                  "slot_has": {
                    "slot": 13,
                    "item": "sample:ruby",
                    "amount": 3
                  }
                },
                "else": [
                  {
                    "message": "<red>Put 3 rubies in the second slot."
                  },
                  "stop"
                ]
              },
              {
                "require": [
                  {
                    "take_money": 200
                  }
                ],
                "else": [
                  {
                    "message": "<red>You need 200 coins."
                  }
                ]
              },
              {
                "custody.consume": {
                  "slot": 11,
                  "await": "saved"
                }
              },
              {
                "custody.consume": {
                  "slot": 13,
                  "await": "saved"
                }
              },
              {
                "give_item": {
                  "item": "bench:refined_ruby_sword",
                  "amount": 1
                }
              },
              "gui.refresh"
            ]
          }
        }
      ]
    }
  ],
