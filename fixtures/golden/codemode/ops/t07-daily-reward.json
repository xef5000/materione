            "commands": [
              "daily"
            ]
          }
        },
        {
          "field": [
            "daily",
            "layers"
          ],
          "value": [
            {
              "type": "materione:button",
              "id": "claim",
              "x": 70,
              "y": 30,
              "width": 36,
              "height": 20
            }
          ]
        }
      ]
    },
    {
      "kind": "logicEdit",
      "path": "guis/daily.yml",
      "edits": [
        {
          "op": "addRule",
          "index": 0,
          "rule": {
            "on": "gui.click",
            "layer": "claim",
            "do": [
              {
                "set_var": {
                  "var": "today",
                  "op": "set",
                  "value": "${floor(now() / 86400)}"
                }
              },
              {
                "if": "${vars.today > vars.player.bench.daily_day}",
                "else": [
                  {
                    "message": "<red>Come back tomorrow."
                  },
                  "stop"
                ]
              },
              {
                "set_var": {
                  "var": "bench:daily_streak",
                  "op": "set",
                  "value": "${vars.today == vars.player.bench.daily_day + 1 ? min(vars.player.bench.daily_streak + 1, 7) : 1}"
                }
              },
              {
                "set_var": {
                  "var": "bench:daily_day",
                  "op": "set",
                  "value": "${vars.today}"
                }
              },
              {
                "choose": [
                  {
                    "if": "${vars.player.bench.daily_streak == 1}",
                    "then": [
                      {
                        "give_money": 100
                      }
                    ]
                  },
                  {
                    "if": "${vars.player.bench.daily_streak == 2}",
                    "then": [
                      {
                        "give_money": 200
                      }
                    ]
                  },
                  {
                    "if": "${vars.player.bench.daily_streak == 3}",
                    "then": [
                      {
                        "give_money": 300
                      }
                    ]
                  },
                  {
                    "if": "${vars.player.bench.daily_streak == 4}",
                    "then": [
                      {
                        "give_money": 400
                      }
                    ]
                  },
                  {
                    "if": "${vars.player.bench.daily_streak == 5}",
                    "then": [
                      {
                        "give_money": 500
                      }
                    ]
                  },
                  {
                    "if": "${vars.player.bench.daily_streak == 6}",
                    "then": [
                      {
                        "give_money": 600
                      }
                    ]
                  },
                  {
                    "if": "${vars.player.bench.daily_streak == 7}",
                    "then": [
                      {
                        "give_money": 700
                      }
                    ]
                  }
                ]
              },
              "view.refresh"
            ]
          }
        }
      ]
    }
  ],
