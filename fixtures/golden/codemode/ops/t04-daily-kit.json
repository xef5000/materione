      "kind": "logicEdit",
      "path": "guis/kits.yml",
      "edits": [
        {
          "op": "addRule",
          "index": 0,
          "rule": {
            "on": "gui.click",
            "layer": "daily_kit",
            "do": [
              {
                "if": "${now() - bench:kit_daily_at >= 86400}",
                "else": [
                  {
                    "message": "<red>Come back later."
                  },
                  "stop"
                ]
              },
              {
                "give_item": {
                  "item": "minecraft:golden_apple",
                  "amount": 1
                }
              },
              {
                "give_item": {
                  "item": "minecraft:experience_bottle",
                  "amount": 1
                }
              },
              {
                "set_var": {
                  "var": "bench:kit_daily_at",
                  "op": "set",
                  "value": "${now()}"
                }
              }
            ]
          }
        }
      ]
    }
