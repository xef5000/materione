    },
    {
      "kind": "create",
      "type": "rules",
      "id": "announce",
      "edits": [
        {
          "field": [
            "announce",
            "description"
          ],
          "value": "Broadcast rotating server tips every 5 minutes"
        }
      ]
    },
    {
      "kind": "logicEdit",
      "path": "rules/announce.yml",
      "edits": [
        {
          "op": "addRule",
          "index": 0,
          "rule": {
            "on": "every",
            "interval": "5m",
            "do": [
              {
                "choose": [
                  {
                    "if": "${vars.server.bench.tip_index == 0}",
                    "then": [
                      {
                        "broadcast": "<aqua>[Tip] Use /kits for a starter kit."
                      }
                    ]
                  },
                  {
                    "if": "${vars.server.bench.tip_index == 1}",
                    "then": [
                      {
                        "broadcast": "<aqua>[Tip] Vote daily for keys."
                      }
                    ]
                  },
                  {
                    "if": "${vars.server.bench.tip_index == 2}",
                    "then": [
                      {
                        "broadcast": "<aqua>[Tip] Join our Discord: /discord"
                      }
                    ]
                  },
                  {
                    "if": "${vars.server.bench.tip_index == 3}",
                    "then": [
                      {
                        "broadcast": "<aqua>[Tip] Read /rules."
                      }
                    ]
                  }
                ]
              },
              {
                "set_var": {
                  "var": "bench:tip_index",
                  "op": "set",
                  "value": "${(vars.server.bench.tip_index + 1) % 4}"
                }
              }
            ]
          }
        }
      ]
    }
  ],
