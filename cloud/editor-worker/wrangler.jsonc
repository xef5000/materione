{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "materione-editor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    {
      "pattern": "editor.materione.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../webui/build/spa",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "editor-relay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
