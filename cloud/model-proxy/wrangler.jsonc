{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "materione-model-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Owner can point this at ai.materione.com (default) or model-proxy.materione.com
  // on the materione.com zone.
  "routes": [
    {
      "pattern": "ai.materione.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "model-proxy-allowance",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "POLAR_CREDITS_PRODUCT_ID": "06c6939d-72a3-4bef-8ded-5c6543811a28"
  },
  "observability": {
    "enabled": true
  }
}
