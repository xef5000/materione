# Served by Workers static assets alongside the SPA build (free, unlimited).
# Hashed bundles and the pinned Blockbench build are immutable; the shell is
# always revalidated.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/blockbench/*
  Cache-Control: public, max-age=604800

# Host marker (web.md §6, cloud landing): the SPA reads this header to show the cloud
# landing card and demo. The plugin listener serves the same file without it.
/host.json
  X-Materione-Host: cloud
  Cache-Control: no-cache
